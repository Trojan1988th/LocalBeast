# Voice pipeline + Reader configuration (copy to voice/.env)

# ── Agent API connection ─────────────────────────────────────────────────────
AGENT_API_BASE=http://127.0.0.1:8000
# Basic-auth password for the agent API. If unset, the bot reads
# DASHBOARD_PASSWORD from the repo root .env (same machine).
AGENT_API_PASSWORD=
# Enable knowledge RAG for voice sessions (default off — slower turns)
AGENT_USE_KNOWLEDGE=false

# ── Your voice (REQUIRED for the realtime pipeline) ─────────────────────────
# A clean ~10-30 second recording of the voice you want the agent to speak in.
# Chatterbox-Turbo clones it zero-shot. This repo ships NO voice — it's yours
# to choose. Also used by make_fillers.py to pre-generate filler clips.
VOICE_REF_WAV=

# ── Realtime behavior ────────────────────────────────────────────────────────
# Half-duplex mode: while the agent is speaking, mic input can't interrupt
# (background-noise-proof; deliberate barge-in is also disabled). Default off.
VOICE_HALF_DUPLEX=false
# Fillers: wait before the first filler (seconds) and per-pause probability
FILLER_FIRST_S=2.5
FILLER_PROB=0.6

# ── Reader render service (voice/reader — expressive read-aloud) ────────────
READER_PORT=5005
# Delivery-consistency dials — pick values you like and keep them
READER_TEMPERATURE=0.6
READER_TOP_P=0.9
READER_REPETITION_PENALTY=1.1
# Default Orpheus stock voice (leo, dan, zac, tara, leah, mia, zoe, ...)
READER_DEFAULT_VOICE=leo
# OPT-IN zero-shot cloning: your own reference recording + its EXACT transcript.
# Request voice="clone" once both are set. Label must not be a stock voice name.
READER_REF_WAV=
READER_REF_TRANSCRIPT=
READER_CLONE_LABEL=speaker
# Experimental: prepend the user's message as delivery context (KNOWN to leak
# the user's words into the audio — leave off; see reader_service.py comments)
READER_CONTEXT=off
READER_CONTEXT_MAX_CHARS=1000
